# ── Saveur Backend Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values
# Never commit .env to version control

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=restaurant_db

# JWT Secret (change this to a long random string in production)
JWT_SECRET=saveur_change_this_secret_in_production

# Server Port
PORT=3000

# Default Admin Login (used if Staff table doesn't exist yet)
ADMIN_USER=admin
ADMIN_PASS=saveur123
